SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy anon keys are also supported through SUPABASE_ANON_KEY.
DEEPSEEK_API_KEY=
# Optional: force prepared AI responses even when an API key exists.
AIMERS_DEMO=1
# Server-only key used for background push dispatch and verified payment grants.
SUPABASE_SECRET_KEY=
# Legacy service_role keys are also supported through SUPABASE_SERVICE_ROLE_KEY.
# Generate these with npm run push:keys. Never expose the private key or cron secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://claude-design-green.vercel.app
CRON_SECRET=
# PortOne V2. Keep API and webhook secrets on the server.
# All fields are required before the payment API is enabled.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PAYMENT_ORIGIN=https://claude-design-green.vercel.app
